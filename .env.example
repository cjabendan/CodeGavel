# PocketBase Superuser Credentials
PB_SUPERUSER_EMAIL=owner@example.local
PB_SUPERUSER_PASSWORD=change-this-superuser-password

# Application Admin / Teacher Account
APP_ADMIN_NAME=Teacher
APP_ADMIN_EMAIL=teacher@example.local
APP_ADMIN_PASSWORD=change-this-admin-password

# Worker Authentication & Server Settings
PB_URL=http://127.0.0.1:8090
RENDER_CONCURRENCY=5

# LAN Network Binding
CLASSROOM_HTTP=0.0.0.0:8090

# Allowed CORS Origins (Replace LAN IP as needed)
CLASSROOM_ORIGINS=http://127.0.0.1:8090,http://localhost:3000,http://127.0.0.1:3000